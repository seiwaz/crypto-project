# Copy to .env and fill in.  `.env` is gitignored and is read by the backend only —
# these values are never serialized into an API response, a log line, or the web UI.

# ---------------------------------------------------------------- Toobit (default)
#
# The screener runs entirely on Toobit's PUBLIC endpoints — no credentials needed for
# candles, order book, funding rate or contract specs. Keys are only useful for
# account state, and those endpoints are region-restricted (Toobit blocks a number of
# jurisdictions, including the US; a US VPN exit will get Cloudflare 1010).
#
# If you do add keys, create them READ-only.
TOOBIT_API_KEY=
TOOBIT_API_SECRET=
TOOBIT_BASE_URL=https://api.toobit.com

# ---------------------------------------------------------------- Nobitex (fallback)
#
# Needed only when settings.exchange is "nobitex". Create at nobitex.ir → Settings →
# API keys with READ permission ONLY and an IP whitelist.
#   * A READ-only key cannot be used to trade even if something goes wrong downstream.
#   * `api.nobitex.ir` does not resolve; apiv2 is the live host.
NOBITEX_API_KEY=
NOBITEX_API_SECRET=
NOBITEX_BASE_URL=https://apiv2.nobitex.ir

# Local Ollama. Commentary is optional — if Ollama is absent the dashboard works
# normally with commentary disabled.
OLLAMA_HOST=http://127.0.0.1:11434

# The dashboard binds to loopback only. Do not change to 0.0.0.0.
BIND_HOST=127.0.0.1
BIND_PORT=8787
