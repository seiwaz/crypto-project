# Copy to .env and fill in.  `.env` is gitignored and is read by the backend only —
# these values are never serialized into an API response, a log line, or the web UI.
#
# Create the key at https://nobitex.ir  →  Settings  →  API keys.
#   * Grant READ permission ONLY.  This project never places orders (see README).
#   * Attach an IP whitelist restricted to this machine's public IP.
#   * If the key is ever exposed, revoke it from that page immediately.

NOBITEX_API_KEY=
NOBITEX_API_SECRET=

# Working host. `api.nobitex.ir` does not resolve (NXDOMAIN); apiv2 is the live host.
NOBITEX_BASE_URL=https://apiv2.nobitex.ir

# Local Ollama. Commentary is optional — if Ollama is absent the dashboard works
# normally with commentary disabled.
OLLAMA_HOST=http://127.0.0.1:11434

# The dashboard binds to loopback only. Do not change to 0.0.0.0.
BIND_HOST=127.0.0.1
BIND_PORT=8787
